# Server-only (no NEXT_PUBLIC_ prefix): the backend's real URL. Never sent to
# the browser -- app/api/backend/[...path]/route.ts proxies requests through
# this, which is also why no CORS configuration is needed on the backend.
BACKEND_API_URL=http://localhost:8000

# Optional: comma-separated bank profile keys to offer in the upload form
# (e.g. "mcb,samba,fwb,ubl,bop,allied,wio,adib,aaib,maerki,pingan"). The
# backend has no endpoint listing these, so this list is maintained here.
# Unset shows only "Auto detect", which the backend always accepts.
BANK_PROFILES=mcb,samba,fwb,ubl,bop,allied,wio,adib,aaib,maerki,pingan

# Optional: override the magic-link redirect URL for local dev.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
