# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...   # server-side only -- never expose this to a browser

# Optional (defaults shown)
STATEMENT_BUCKET=statements
FREE_MONTHLY_LIMIT=3

# Optional -- enables the LLM fallback tier (bank_profile="auto" escalating
# past the heuristic parser). The app starts fine without this; the fallback
# just returns a clean 422 on the request that needed it.
ANTHROPIC_API_KEY=sk-ant-...
