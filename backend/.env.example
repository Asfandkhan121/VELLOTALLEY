# Required
SUPABASE_URL=https://xujijonwxxoxxtvhorfi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional (defaults shown)
STATEMENT_BUCKET=statements
FREE_MONTHLY_LIMIT=3
# Optional comma-separated Supabase auth user IDs exempt from the monthly limit.
FREE_UNLIMITED_USER_IDS=

# Optional -- LLM fallback tier (bank_profile="auto" escalating past the
# heuristic parser). The app starts fine without it; the fallback just
# returns a clean 422 on the request that needed it.
#
# Default: any OpenAI-compatible endpoint. Free options:
#   Self-hosted (private, nothing leaves your machine):
#     ollama pull qwen2.5:7b-instruct
#     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b-instruct
#   Free-tier hosted (statement TEXT is sent to that provider -- check its
#   data terms, and update the Privacy page):
#     LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_API_KEY=...   LLM_MODEL=...
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_CHUNK_CHARS=6000

# Optional alternative: set LLM_PROVIDER=anthropic plus this key.
ANTHROPIC_API_KEY=
